---
name: {{ skill.name }}
description: {{ skill.description }}
{% if skill.when_to_use -%}
when_to_use: {{ skill.when_to_use }}
{% endif -%}
{% if skill.argument_hint -%}
argument-hint: {{ skill.argument_hint }}
{% endif -%}
{% if skill.arguments -%}
arguments: {{ skill.arguments }}
{% endif -%}
{% if skill.allowed_tools -%}
allowed-tools: {{ skill.allowed_tools }}
{% endif -%}
{% if skill.disallowed_tools -%}
disallowed-tools: {{ skill.disallowed_tools }}
{% endif -%}
{% if skill.disable_model_invocation -%}
disable-model-invocation: true
{% endif -%}
{% if skill.hidden_from_menu -%}
user-invocable: false
{% endif -%}
{% if skill.model -%}
model: {{ skill.model }}
{% endif -%}
{% if skill.effort -%}
effort: {{ skill.effort }}
{% endif -%}
{% if paths -%}
paths:
{% for p in paths %}  - "{{ p }}"
{% endfor -%}
{% endif -%}
{% if skill.context_fork -%}
context: fork
{% if skill.agent -%}
agent: {{ skill.agent }}
{% endif -%}
{% if skill.background -%}
background: true
{% endif -%}
{% endif -%}
---
{{ skill.body }}
