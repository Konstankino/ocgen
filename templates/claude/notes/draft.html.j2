<!doctype html>
<html lang="{{ w.lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="no-referrer">
<meta name="generator" content="ocgen — the /intent issue draft editor; Save writes the .md file">
<title>{{ name }} · {{ w.title }}</title>
<style>
{% include "page.css" %}
[hidden] { display: none !important; }
.draft .toolbar { display: flex; flex-wrap: wrap; gap: 12px; justify-content: space-between; align-items: center; margin: 0 0 14px; }
.draft .tabs { padding: 0; margin: 0; border: 0; }
.draft .actions { display: flex; flex-wrap: wrap; gap: 8px; }
.draft .actions button, .banner button { font: inherit; font-size: 14px; font-weight: 600; color: var(--text); background: var(--surface);
  border: 1px solid var(--border); border-radius: 8px; padding: 7px 14px; cursor: pointer; box-shadow: var(--shadow); }
.draft .actions button:hover, .banner button:hover { border-color: var(--border-strong); }
.draft button.primary { background: var(--accent); border-color: var(--accent); color: var(--on-color); }
.draft .pane { padding: 18px 22px; }
.draft textarea { display: block; width: 100%; min-height: 62vh; resize: vertical; border: 0; outline: none; background: transparent; color: var(--text);
  font: 14px/1.6 ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace; tab-size: 4; }
.status.warn { color: var(--c-orange); font-weight: 600; }
.status.bad { color: var(--c-red); font-weight: 600; }
.banner { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; border-left: 4px solid var(--c-orange); background: var(--note-bg);
  padding: 12px 16px; border-radius: 0 10px 10px 0; margin: 0 0 16px; }
.banner span { flex: 1 1 260px; }
/* the preview, close to how GitHub draws an issue */
.markdown-body { font-size: 16px; line-height: 1.6; overflow-wrap: anywhere; }
.markdown-body > :first-child { margin-top: 0; }
.markdown-body > :last-child { margin-bottom: 0; }
.markdown-body h1, .markdown-body h2 { padding-bottom: .3em; border-bottom: 1px solid var(--border); }
.markdown-body h1 { font-size: 2em; margin: 24px 0 16px; }
.markdown-body h2 { font-size: 1.5em; margin: 24px 0 16px; }
.markdown-body h3 { font-size: 1.25em; margin: 24px 0 16px; }
.markdown-body h4, .markdown-body h5, .markdown-body h6 { font-size: 1em; margin: 24px 0 16px; }
.markdown-body p, .markdown-body ul, .markdown-body ol, .markdown-body table, .markdown-body pre,
.markdown-body blockquote, .markdown-body details { margin: 0 0 16px; }
.markdown-body ul, .markdown-body ol { padding-left: 2em; }
.markdown-body li + li { margin-top: .25em; }
.markdown-body li:has(> input[type="checkbox"]) { list-style: none; }
.markdown-body input[type="checkbox"] { margin: 0 .3em .2em -1.4em; vertical-align: middle; }
.markdown-body summary { cursor: pointer; }
.markdown-body details > :not(summary):first-of-type { margin-top: 12px; }
.markdown-body table { width: auto; border-collapse: collapse; }
.markdown-body th, .markdown-body td { padding: 6px 13px; border: 1px solid var(--border); }
.markdown-body th { text-transform: none; letter-spacing: 0; font-size: 15px; font-weight: 600; color: var(--text); }
.markdown-body blockquote { padding: 0 1em; color: var(--muted); border-left: .25em solid var(--border-strong); }
.markdown-body code { background: var(--surface-2); padding: .2em .4em; border-radius: 6px; }
.markdown-body pre code { padding: 0; background: transparent; }
.markdown-body hr { border: 0; border-top: 1px solid var(--border); margin: 24px 0; }
.markdown-body kbd { font: 12px ui-monospace, Menlo, Consolas, monospace; padding: 2px 5px; border: 1px solid var(--border-strong);
  border-bottom-width: 2px; border-radius: 6px; background: var(--surface-2); }
</style>
</head>
<body data-rev="{{ rev }}" data-approvers="{{ approvers }}">
<div class="offline">{{ w.offline }}</div>
<div id="words" hidden data-saved="{{ w.saved }}" data-unsaved="{{ w.unsaved }}" data-saving="{{ w.saving }}"
  data-save-failed="{{ w.save_failed }}" data-copied="{{ w.copied }}" data-copy-failed="{{ w.copy_failed }}"
  data-updated="{{ w.updated }}" data-changed="{{ w.changed }}" data-conflict="{{ w.conflict }}"></div>
<main class="draft">
  <header>
    <div class="eyebrow">/intent · {{ w.title }}</div>
    <h1><code>{{ name }}</code></h1>
    <div class="pills">
      <span class="pill"><code>{{ source }}</code></span>
      <span class="pill status" id="status" role="status">{{ w.saved }}</span>
    </div>
  </header>
  <div class="banner" id="approvers" role="alert"{% if not gaps %} hidden{% endif %}>
    <span><span id="missing-text"{% if not missing %} hidden{% endif %}>{{ w.missing }} <strong id="missing-list">{{ missing }}</strong></span>
    <span id="says-none"{% if not says_none %} hidden{% endif %}>{{ w.says_none }}</span></span>
  </div>
  <div class="banner" id="banner" role="alert" hidden>
    <span id="banner-text"></span>
    <button type="button" id="load-disk">{{ w.load_disk }}</button>
    <button type="button" id="keep-mine">{{ w.keep_mine }}</button>
    <button type="button" id="overwrite">{{ w.overwrite }}</button>
  </div>
  <div class="toolbar">
    <nav class="tabs" role="tablist">
      <button type="button" role="tab" id="tab-write" aria-controls="pane-write" aria-selected="false">{{ w.write }}</button>
      <button type="button" role="tab" id="tab-preview" aria-controls="pane-preview" aria-selected="true">{{ w.preview }}</button>
    </nav>
    <div class="actions">
      <button type="button" id="save" class="primary" title="Ctrl+S / ⌘S">{{ w.save }}</button>
      <button type="button" id="copy-md">{{ w.copy_markdown }}</button>
      <button type="button" id="copy-html">{{ w.copy_formatted }}</button>
    </div>
  </div>
  <section class="card pane" id="pane-write" role="tabpanel" hidden>
    <textarea id="text" spellcheck="true" aria-label="{{ w.write }}">
{{ text }}</textarea>
  </section>
  <section class="card pane markdown-body" id="pane-preview" role="tabpanel">{{ preview }}</section>
  <footer>{{ w.footer }}</footer>
</main>
<script nonce="{{ nonce }}">
(function () {
  "use strict";
  var $ = function (id) { return document.getElementById(id); };
  var words = $("words").dataset;
  var text = $("text"), preview = $("pane-preview"), status = $("status");
  var slug = decodeURIComponent(location.pathname.split("/").pop().replace(/\.html$/, ""));
  // `saved` is the text the file holds as far as this page knows, at revision `rev`.
  var rev = document.body.getAttribute("data-rev");
  var saved = text.value, previewed = text.value;
  var saving = false, laterRev = null, disk = null, flash = null;

  function dirty() { return text.value !== saved; }

  // Every approver the project has now must be @mentioned: that is how GitHub
  // notifies them (the same rule ocgen applies after each write).
  var approvers = (document.body.getAttribute("data-approvers") || "").split(" ").filter(Boolean);
  function quote(s) { return s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"); }
  function checkApprovers() {
    if (!approvers.length) return;
    var t = text.value;
    var missing = approvers.filter(function (a) {
      return !new RegExp("(^|[^\\w])@" + quote(a.replace(/^@/, "")) + "($|[^\\w/-])", "i").test(t);
    });
    var none = /no approvers configured/i.test(t);
    $("missing-list").textContent = missing.join(", ");
    $("missing-text").hidden = !missing.length;
    $("says-none").hidden = !none;
    $("approvers").hidden = !missing.length && !none;
  }
  function say(msg, kind) {
    clearTimeout(flash);
    status.textContent = msg;
    status.className = "pill status" + (kind ? " " + kind : "");
  }
  function settle() { say(dirty() ? words.unsaved : words.saved, dirty() ? "warn" : ""); }

  // Write / Preview
  function current() { return $("pane-write").hidden ? "preview" : "write"; }
  function show(pane) {
    ["write", "preview"].forEach(function (p) {
      $("pane-" + p).hidden = p !== pane;
      $("tab-" + p).setAttribute("aria-selected", p === pane ? "true" : "false");
    });
    if (pane === "preview") render(); else text.focus();
  }
  function outward() {
    preview.querySelectorAll("a[href]").forEach(function (a) { a.target = "_blank"; a.rel = "noopener noreferrer"; });
  }
  function render() {
    if (text.value === previewed) return Promise.resolve();
    var asked = text.value;
    return fetch("render", { method: "POST", body: asked, headers: { "Content-Type": "text/plain;charset=UTF-8" } })
      .then(function (r) { if (!r.ok) throw new Error(r.status); return r.text(); })
      .then(function (html) { previewed = asked; preview.innerHTML = html; outward(); })
      .catch(function () {});
  }
  $("tab-write").addEventListener("click", function () { show("write"); });
  $("tab-preview").addEventListener("click", function () { show("preview"); });

  // The banner: the file changed on disk, or a save was refused because of it.
  function banner(msg, conflict) {
    $("banner-text").textContent = msg;
    $("keep-mine").hidden = conflict;
    $("overwrite").hidden = !conflict;
    $("banner").hidden = false;
  }
  function unbanner() { $("banner").hidden = true; }
  function take(t, r) {
    // The editor gives its text back with LF line endings, whatever the file has.
    text.value = t; saved = text.value; rev = r; unbanner(); checkApprovers();
    if (current() === "preview") render();
  }
  $("load-disk").addEventListener("click", function () { if (disk) take(disk.text, disk.rev); settle(); });
  // Keep mine: the next save replaces the newer file.
  $("keep-mine").addEventListener("click", function () { if (disk) rev = disk.rev; unbanner(); settle(); });
  $("overwrite").addEventListener("click", function () { if (disk) { rev = disk.rev; unbanner(); save(); } });

  // Save, only over the version this page last saw.
  function save() {
    if (saving) return;
    var body = text.value;
    // The editor takes at most 1 MiB (GitHub takes far less).
    if (new Blob([body]).size > 1048576) { say(words.saveFailed, "bad"); return; }
    saving = true;
    say(words.saving);
    fetch(encodeURIComponent(slug) + ".md?rev=" + encodeURIComponent(rev), {
      method: "POST", body: body, headers: { "Content-Type": "text/plain;charset=UTF-8" }
    })
      .then(function (r) { return r.json().then(function (j) { return { code: r.status, j: j }; }); })
      .then(function (x) {
        saving = false;
        if (x.code === 200) { rev = x.j.rev; saved = body; unbanner(); settle(); }
        else if (x.code === 409) { disk = x.j; banner(words.conflict, true); say(words.unsaved, "warn"); }
        else say(words.saveFailed, "bad");
        var later = laterRev; laterRev = null;
        if (later) changed(later);
      })
      .catch(function () { saving = false; say(words.saveFailed, "bad"); });
  }
  $("save").addEventListener("click", save);
  document.addEventListener("keydown", function (e) {
    if ((e.metaKey || e.ctrlKey) && !e.altKey && (e.key === "s" || e.key === "S")) { e.preventDefault(); save(); }
  });
  text.addEventListener("input", function () { settle(); checkApprovers(); });
  window.addEventListener("beforeunload", function (e) { if (dirty()) { e.preventDefault(); e.returnValue = ""; } });

  // Copy: the Markdown as it is in the editor, or the preview with its formatting.
  function copied(p) {
    p.then(function () { say(words.copied); flash = setTimeout(settle, 1600); },
           function () { say(words.copyFailed, "bad"); });
  }
  function bySelection(node) {
    var range = document.createRange(), sel = window.getSelection();
    range.selectNodeContents(node);
    sel.removeAllRanges();
    sel.addRange(range);
    var ok = document.execCommand("copy");
    sel.removeAllRanges();
    return ok ? Promise.resolve() : Promise.reject(new Error("copy"));
  }
  $("copy-md").addEventListener("click", function () {
    if (navigator.clipboard && window.isSecureContext) { copied(navigator.clipboard.writeText(text.value)); return; }
    var wasHidden = $("pane-write").hidden;
    $("pane-write").hidden = false;
    text.select();
    var ok = document.execCommand("copy");
    $("pane-write").hidden = wasHidden;
    copied(ok ? Promise.resolve() : Promise.reject(new Error("copy")));
  });
  $("copy-html").addEventListener("click", function () {
    copied(render().then(function () {
      if (navigator.clipboard && navigator.clipboard.write && window.ClipboardItem && window.isSecureContext) {
        return navigator.clipboard.write([new ClipboardItem({
          "text/html": new Blob([preview.innerHTML], { type: "text/html" }),
          "text/plain": new Blob([preview.innerText], { type: "text/plain" })
        })]).catch(function () { return viaSelection(); });
      }
      return viaSelection();
    }));
  });
  function viaSelection() {
    var wasHidden = preview.hidden;
    preview.hidden = false;
    return bySelection(preview).finally(function () { preview.hidden = wasHidden; });
  }

  // Changes made elsewhere — Claude, another editor — arrive as `changed` events.
  function changed(newRev) {
    if (!newRev || newRev === rev) return;
    if (saving) { laterRev = newRev; return; }
    fetch(encodeURIComponent(slug) + ".md")
      .then(function (r) { return r.json(); })
      .then(function (j) {
        if (j.rev === rev) return;
        if (!dirty()) { take(j.text, j.rev); say(words.updated); flash = setTimeout(settle, 2500); }
        else { disk = j; banner(words.changed, false); }
      })
      .catch(function () {});
  }
  var errors = 0;
  var es = new EventSource("events?topic=" + encodeURIComponent(slug) + "&rev=" + encodeURIComponent(rev));
  es.addEventListener("changed", function (e) { changed(e.data); });
  es.onopen = function () { errors = 0; document.body.removeAttribute("data-viewer"); };
  es.onerror = function () { if (++errors > 5) document.body.setAttribute("data-viewer", "offline"); };

  outward();
  show(text.value.trim() ? "preview" : "write");
})();
</script>
</body>
</html>
