{
  "$schema": "https://opencode.ai/config.json",
  "model": "{{ primary_ref }}",
  "provider": {
{% for p in providers %}    "{{ p.key }}": {
      "npm": "{{ p.npm }}",
      "name": "{{ p.name }}",
      "options": { "baseURL": "{{ p.base_url }}" },
      "models": {
{% for m in p.models %}        "{{ m.id }}": { "name": "{{ m.name }}" }{% if not loop.last %},{% endif %}
{% endfor %}      }
    }{% if not loop.last %},{% endif %}
{% endfor %}  },
  "agent": {
    "compaction": { "model": "{{ utility_ref }}" },
    "title": { "model": "{{ utility_ref }}" },
    "summary": { "model": "{{ utility_ref }}" }
  }
}
